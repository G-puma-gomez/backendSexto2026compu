<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "https://backendsexto2026compu-1.onrender.com"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Accept, Origin"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
    Header set Access-Control-Allow-Credentials "true"
</IfModule>

RewriteEngine On

# 1. Interceptar peticiones OPTIONS (Preflight) y responder un 200 directo sin tocar PHP
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ - [R=200,L]

# 2. Tu enrutamiento normal para archivos que no existen físicamente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
