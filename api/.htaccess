RewriteEngine On

# Pasar la cabecera Authorization al entorno de PHP antes de redireccionar
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Redirigir todo el tráfico a la carpeta public de forma interna si no es un archivo real
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
